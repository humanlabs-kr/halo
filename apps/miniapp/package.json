{
  "name": "@halo/miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-locales.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "cf-codegen": "wrangler types -c wrangler.jsonc",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build --mode staging && wrangler deploy --env staging",
    "deploy:production": "CLOUDFLARE_ENV=production vite build --mode production && wrangler deploy --env production"
  },
  "dependencies": {
    "@halo/contracts": "workspace:*",
    "@line/liff": "^2.27.3",
    "@linenext/dapp-portal-sdk": "^1.5.2",
    "@marsidev/react-turnstile": "^1.5.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query": "^5.90.2",
    "@worldcoin/minikit-js": "1.9.8",
    "canvas-confetti": "^1.9.4",
    "dayjs": "^1.11.18",
    "eruda": "3.4.1",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^15.5.2",
    "react-router": "^7.9.4",
    "tailwindcss": "^4.1.17",
    "vaul": "^1.1.2",
    "viem": "^2.39.0",
    "wagmi": "^3.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250507.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.2",
    "wrangler": "4.48.0"
  }
}
