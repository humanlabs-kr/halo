{
  "name": "@halo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8001",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "cf-codegen": "wrangler types",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "lint": "eslint ."
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.2.2",
    "@halo/contracts": "workspace:*",
    "@halo/database": "workspace:*",
    "@hono/swagger-ui": "^0.5.1",
    "@hono/zod-openapi": "^0.19.10",
    "date-fns": "^4.1.0",
    "hono": "^4.9.5",
    "ksuid": "^3.0.0",
    "openai": "^6.9.1",
    "siwe": "^3.0.0",
    "viem": "^2.39.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^9.33.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "4.48.0"
  }
}
